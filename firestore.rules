rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada hogar vive bajo households/<código aleatorio de la URL>.
    // Solo usuarios autenticados (anónimos incluidos) pueden leer/escribir.
    match /households/{hid}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
